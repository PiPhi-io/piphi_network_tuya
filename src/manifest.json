    },
    "set_color_rgb": {
      "kind": "action"
    },
    "set_mode": {
      "kind": "action"
    },
    "set_fan_speed": {
      "kind": "action"
    },
    "set_oscillate": {
      "kind": "action"
    },
    "open_cover": {
      "kind": "action"
    },
    "close_cover": {
      "kind": "action"
    },
    "stop_cover": {
      "kind": "action"
    },
    "set_cover_position": {
      "kind": "action"
    },
    "set_temperature": {
      "kind": "action"
    },
    "set_humidity": {
      "kind": "action"
    }
  },
  "commands": {
    "refresh": {
      "description": "Refresh the latest local Tuya device state.",
      "timeout_ms": 5000
    },
    "turn_on": {
      "description": "Turn the Tuya device on.",
      "timeout_ms": 5000
    },
    "turn_off": {
      "description": "Turn the Tuya device off.",
      "timeout_ms": 5000
    },
    "set_dp": {
      "description": "Set a raw Tuya data point value.",
      "timeout_ms": 5000,
      "args_schema": {
        "dp": {
          "type": "string",
          "label": "Data Point",
          "description": "Tuya DPS key, for example 1 or 20.",
          "required": true
        },
        "value": {
          "type": "string",
          "label": "Value",
          "description": "JSON-ish scalar or string value to send to the device.",
          "required": true
        }
      }
    },
    "set_brightness": {
      "description": "Set a Tuya light brightness percentage.",
      "timeout_ms": 5000,
      "args_schema": {
        "brightness": {
          "type": "number",
          "label": "Brightness Percent",
          "description": "Brightness percentage from 0 to 100.",
          "required": true,
          "minimum": 0,
          "maximum": 100,
          "step": 1,
          "unit": "%"
        }
      }
    },
    "set_color_temp": {
      "description": "Set a Tuya light color temperature percentage.",
      "timeout_ms": 5000,
      "args_schema": {
        "color_temp": {
          "type": "number",
          "label": "Color Temperature Percent",
          "description": "Color temperature percentage from 0 to 100.",
          "required": true,
          "minimum": 0,
          "maximum": 100,
          "step": 1,
          "unit": "%"
        }
      }
    },
    "set_color_rgb": {
      "description": "Set a Tuya light RGB color.",
      "timeout_ms": 5000,
      "args_schema": {
        "r": {
          "type": "number",
          "label": "Red",
          "required": true,
          "minimum": 0,
          "maximum": 255,
          "step": 1
        },
        "g": {
          "type": "number",
          "label": "Green",
          "required": true,
          "minimum": 0,
          "maximum": 255,
          "step": 1
        },
        "b": {
          "type": "number",
          "label": "Blue",
          "required": true,
          "minimum": 0,
          "maximum": 255,
          "step": 1
        }
      }
    },
    "set_mode": {
      "description": "Set a Tuya light, fan, climate, humidifier, or air purifier mode.",
      "timeout_ms": 5000,
      "args_schema": {
        "mode": {
          "type": "string",
          "label": "Mode",
          "description": "Typical light modes are white, colour, scene, or music. Fan, climate, humidifier, and air purifier modes depend on the device and often include values like normal, sleep, auto, manual, heat, cool, eco, mist, low, medium, high, or off.",
          "required": true,
          "options": [
            "white",
            "colour",
            "scene",
            "music",
            "normal",
            "sleep",
            "nature",
            "auto",
            "manual",
            "heat",
            "cool",
            "eco",
            "off",
            "mist",
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "set_fan_speed": {
      "description": "Set a Tuya fan or air purifier speed percentage.",
      "timeout_ms": 5000,
      "args_schema": {
        "speed": {
          "type": "number",
          "label": "Fan Speed Percent",
          "description": "Requested fan speed from 0 to 100 percent.",
          "required": true,
          "minimum": 0,
          "maximum": 100,
          "step": 1,
          "unit": "%"
        }
      }
    },
    "set_oscillate": {
      "description": "Enable or disable Tuya fan oscillation.",
      "timeout_ms": 5000,
      "args_schema": {
        "oscillating": {
          "type": "boolean",
          "label": "Oscillating",
          "required": true
        }
      }
    },
    "open_cover": {
      "description": "Open a Tuya curtain, blind, or shade.",
      "timeout_ms": 5000
    },
    "close_cover": {
      "description": "Close a Tuya curtain, blind, or shade.",
      "timeout_ms": 5000
    },
    "stop_cover": {
      "description": "Stop a moving Tuya curtain, blind, or shade.",
      "timeout_ms": 5000
    },
    "set_cover_position": {
      "description": "Set a Tuya cover position percentage.",
      "timeout_ms": 5000,
      "args_schema": {
        "position": {
          "type": "number",
          "label": "Position Percent",
          "description": "Requested cover position from 0 to 100 percent.",
          "required": true,
          "minimum": 0,
          "maximum": 100,
          "step": 1,
          "unit": "%"
        }
      }
    },
    "set_temperature": {
      "description": "Set a Tuya climate target temperature in Celsius.",
      "timeout_ms": 5000,
      "args_schema": {
        "temperature_c": {
          "type": "number",
          "label": "Target Temperature \u00b0C",
          "description": "Requested target temperature in degrees Celsius.",
          "required": true,
          "minimum": 5,
          "maximum": 35,
          "step": 0.5,
          "unit": "C"
        }
      }
    },
    "set_humidity": {
      "description": "Set a Tuya humidifier target humidity percentage.",
      "timeout_ms": 5000,
      "args_schema": {
        "humidity_percent": {
          "type": "number",
          "label": "Target Humidity Percent",
          "description": "Requested target humidity percentage from 0 to 100.",
          "required": true,
          "minimum": 0,
          "maximum": 100,
          "step": 1,
          "unit": "%"
        }
      }
    }
  },
